# Dependencies
node_modules/
.pnpm-store/

# Build output — each extension builds into out/, which Freelens loads directly
out/
dist/
*.tsbuildinfo

# Extension packages
*.tgz

# Local environment — never commit; it points at kubeconfigs outside the repo
.env
.env.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Tooling caches
.turbo/
# Vitest reports only: a source folder may be named coverage too.
/packages/*/coverage/

# Scratch for scripts/security/verify-supply-chain.sh and scripts/deps-refresh.sh.
.osv-probe/
.deps-refresh/
