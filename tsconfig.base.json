{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    "moduleResolution": "bundler",

    // The automatic runtime, so JSX compiles to react/jsx-runtime imports that the
    // shared build maps onto the host's FreelensExtensionApi.ReactJsxRuntime. The
    // classic runtime would need React itself in scope as a value, which a type-only
    // import silently removes — and the JSX then fails at runtime, not at build.
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "declaration": false
  }
}
