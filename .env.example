# Template for .env, which is git-ignored. `make up` copies this on first run.
# Fill in the values for your machine — nothing here should ever be committed.

# Absolute path to the kubeconfig mounted into the Freelens container, read-only.
#
# `make cluster` starts a k3s of its own and writes one to
# /tmp/freelens-addons-k3s/kubeconfig.yaml, which is the cluster to develop
# against: it is disposable, it has ArgoCD and the Trivy operator installed,
# and nothing on it matters. Point this at that file.
#
# Any other cluster works too, and the container only ever mounts this
# read-only.
KUBECONFIG_PATH=

# Where `make cluster` writes that kubeconfig. Under /tmp on purpose: it cannot
# be committed and does not survive a reboot.
DEV_KUBECONFIG_DIR=/tmp/freelens-addons-k3s

# Freelens release installed in the image. Extension manifests declare
# engines.freelens, which must stay compatible with this.
FREELENS_VERSION=1.10.3

# Where noVNC is served. Changing this changes the URL `make open` uses.
NOVNC_PORT=6080
VNC_PORT=5900
SCREEN_GEOMETRY=1600x900x24

# Node used by the build container. The extension toolchain requires >= 22.
NODE_VERSION=24

# Comma-separated domains to redact when `dev/cluster/cluster.sh fixtures` writes
# test fixtures from your cluster. Anything listed here is replaced with
# example.test, so a private hostname never reaches the repository. List the
# domains your Ingresses and HTTPRoutes use.
FIXTURE_REDACT_DOMAINS=

# Keeps bind-mounted build output owned by you rather than by root.
# `make up` fills these in from `id -u` / `id -g`.
USER_UID=
USER_GID=
