        },
        "name": "kubelet",
        "namespace": "monitoring",
        "resourceVersion": "178907",
        "selfLink": "/apis/monitoring.coreos.com/v1/namespaces/monitoring/servicemonitors/kubelet",
        "uid": "60043e91-a858-4a27-9d46-943db67c894d"
      },
      "spec": {
        "endpoints": [
          {
            "bearerTokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
            "honorLabels": true,
            "honorTimestamps": false,
            "metricRelabelings": [
              {
                "action": "drop",
                "regex": "container_tasks_state|container_network_(tcp|udp)_usage_total|container_cpu_load_average_10s",
                "sourceLabels": [
                  "__name__"
                ]
              },
              {
                "action": "drop",
                "regex": "container_spec_.*|container_blkio_device_usage_total|container_pressure_.*",
                "sourceLabels": [
                  "__name__"
                ]
              },
              {
                "action": "drop",
                "regex": "container_memory_(failures|failcnt)_total|container_(file_descriptors|sockets|threads|threads_max|processes|ulimits_soft)",
                "sourceLabels": [
                  "__name__"
                ]
              },
              {
                "action": "drop",
                "regex": "container_fs_(inodes|io|limit|read_seconds|write_seconds|reads_merged|writes_merged|sector).*",
                "sourceLabels": [
                  "__name__"
                ]
              }
            ],
            "path": "/metrics/cadvisor",
            "port": "https-metrics",
            "scheme": "https",
            "tlsConfig": {
              "insecureSkipVerify": true
            }
          },
          {
            "bearerTokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
            "honorLabels": true,
            "metricRelabelings": [
              {
                "action": "keep",
                "regex": "kubelet_volume_stats_(used|capacity|available)_bytes",
                "sourceLabels": [
                  "__name__"
                ]
              }
            ],
            "path": "/metrics",
            "port": "https-metrics",
            "scheme": "https",
            "tlsConfig": {
              "insecureSkipVerify": true
            }
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "kube-system"
          ]
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "kubelet"
          }
        }
      }
