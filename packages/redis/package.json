{
  "name": "@freelens-addons/redis",
  "version": "1.0.0",
  "private": true,
  "description": "Which Redis replications, clusters and standalones need attention, which node is master, and why one is stuck",
  "license": "Apache-2.0",
  "main": "out/main/index.mjs",
  "renderer": "out/renderer/index.js",
  "files": [
    "out"
  ],
  "engines": {
    "freelens": "^2.0.0",
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && vite build --mode main",
    "watch": "vite build --watch --mode main & vite build --watch",
    "type:check": "tsc -p src/main && tsc -p src/renderer && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:e2e-writes": "vitest run --config e2e/writes.config.ts"
  },
  "devDependencies": {
    "@freelensapp/extensions": "^2.0.0",
    "@freelensapp/kube-api": "^1.10.3",
    "@freelensapp/kube-object": "^1.10.3",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.4.0",
    "mobx": "~7.0.6",
    "mobx-react": "~10.0.2",
    "react": "~19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
